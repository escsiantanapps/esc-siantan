{
  "appId": "com.escsiantan.app",
  "appName": "ESC Siantan",
  "webDir": "dist",
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "launchShowDuration": 500,
      "backgroundColor": "#F4511E",
      "androidScaleType": "CENTER",
      "splashFullScreen": true,
      "splashImmersive": true,
      "useDialog": false
    }
  }
}
